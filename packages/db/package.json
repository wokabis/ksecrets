{
  "name": "@ksecrets/db",
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "db:generate": "kysely-codegen --out-file=src/generated.ts --dialect=sqlite --url=$DATABASE_URL",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@ksecrets/crypto": "workspace:*",
    "@ksecrets/types": "workspace:*",
    "kysely": "^0.27.0",
    "kysely-d1": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250408.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.2.0",
    "kysely-codegen": "^0.16.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}