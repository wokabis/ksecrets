{
  "name": "@pwpush/db",
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "db:generate": "kysely-codegen --out-file=src/generated.ts --dialect=sqlite --url=$DATABASE_URL",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@pwpush/types": "workspace:*",
    "@pwpush/crypto": "workspace:*",
    "kysely": "^0.27.0",
    "better-sqlite3": "^9.4.0",
    "better-sqlite3-helper": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "kysely-codegen": "^0.16.0",
    "tsx": "^4.16.0"
  }
}