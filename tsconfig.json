{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@ksecrets/types": ["packages/types/src"],
      "@ksecrets/crypto": ["packages/crypto/src"],
      "@ksecrets/db": ["packages/db/src"],
      "@ksecrets/auth": ["packages/auth/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}