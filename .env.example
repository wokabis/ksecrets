# Database (use one of these)
# SQLite (local dev)
DATABASE_PATH=./data/pwpush.db

# Turso (libSQL) - free tier
# DATABASE_URL=libsql://your-db.turso.io?authToken=your-token

# Neon Postgres - free tier
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname

# Supabase - free tier
# DATABASE_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres

# Encryption keys (generate with: openssl rand -hex 32)
SECRET_KEY_BASE=your-secret-key-base-32-bytes-hex
PWPUSH_MASTER_KEY=your-master-encryption-key-32-bytes-hex

# Cloudflare (for production deployment)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id

# R2 Object Storage (for file uploads)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=pwpush-files
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Frontend (Vite)
VITE_MASTER_KEY=your-master-encryption-key-32-bytes-hex