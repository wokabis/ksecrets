# Node-side tooling only (db scripts). The Worker uses D1 bindings, not a connection string.
DATABASE_PATH=./data/ksecrets.db

# JWT signing secret (32+ random bytes, hex): openssl rand -hex 32
SECRET_KEY_BASE=your-secret-key-base-32-bytes-hex

# Outer payload encryption key (32 bytes / 64 hex chars): openssl rand -hex 32
KSECRETS_MASTER_KEY=your-master-encryption-key-32-bytes-hex

# Worker runtime (also set these in apps/api/.dev.vars for `wrangler dev`)
ENVIRONMENT=development
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional email notifications (Resend)
RESEND_API_KEY=
EMAIL_FROM=KSecrets <onboarding@resend.dev>

# Frontend build (Vite) - the API base URL for the web app
VITE_API_URL=
