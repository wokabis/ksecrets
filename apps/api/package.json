{
  "name": "@pwpush/api",
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "deploy": "wrangler deploy",
    "db:generate": "kysely-codegen --out-file=../packages/db/src/generated.ts --dialect=sqlite --url=$DATABASE_URL",
    "db:migrate": "tsx ../packages/db/src/migrate.ts",
    "db:seed": "tsx ../packages/db/src/seed.ts"
  },
  "dependencies": {
    "@pwpush/types": "workspace:*",
    "@pwpush/crypto": "workspace:*",
    "@pwpush/db": "workspace:*",
    "@pwpush/auth": "workspace:*",
    "hono": "^4.5.0",
    "zod": "^3.23.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0",
    "wrangler": "^3.70.0",
    "tsx": "^4.16.0",
    "kysely-codegen": "^0.16.0"
  }
}