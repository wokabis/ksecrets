{
  "name": "@ksecrets/api",
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:generate": "kysely-codegen --out-file=../packages/db/src/generated.ts --dialect=sqlite --url=$DATABASE_URL",
    "db:migrate": "tsx ../packages/db/src/migrate.ts",
    "db:seed": "tsx ../packages/db/src/seed.ts"
  },
  "dependencies": {
    "@ksecrets/auth": "workspace:*",
    "@ksecrets/crypto": "workspace:*",
    "@ksecrets/db": "workspace:*",
    "@ksecrets/types": "workspace:*",
    "hono": "^4.5.0",
    "hono-rate-limiter": "^0.5.4",
    "uuid": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.0.0",
    "kysely-codegen": "^0.16.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.70.0"
  }
}