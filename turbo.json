{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "lint": {
      "outputs": []
    },
    "db:generate": {
      "outputs": ["packages/db/src/generated/**"]
    },
    "db:migrate": {
      "dependsOn": ["db:generate"]
    },
    "db:seed": {
      "dependsOn": ["db:migrate"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "SECRET_KEY_BASE", "PWPUSH_MASTER_KEY"]
}